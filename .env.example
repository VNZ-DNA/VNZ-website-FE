# Copy to `.env.local` (git-ignored) for local work, and set the same variables in
# the Vercel project settings for deploys.

# ── Public VNZ API ───────────────────────────────────────────────────────────
# Base URL for the public VNZ API. Server Components and the `/ung-tuyen` server
# action use it directly. `/lien-he` also receives the resolved contact endpoint
# as a prop so the browser can POST straight to the backend and preserve visitor
# IP for TDD-023 rate limiting. It does not need a NEXT_PUBLIC duplicate.
VNZ_API_URL=https://be-vnz-dna-latest.onrender.com
